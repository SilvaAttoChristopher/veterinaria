# Configuración de Stripe para el pago de citas (Stripe Checkout).
# Copia este archivo a `.env` y completa los valores:
#     cp .env.example .env
# `./run.sh` lo carga antes de arrancar la app.

# Clave secreta de Stripe (Dashboard -> Developers -> API keys)
STRIPE_API_KEY=sk_test_...

# Secreto del endpoint de webhook.
# Local: lo imprime `stripe listen --forward-to localhost:8080/api/pagos/webhook`
# (prefijo whsec_...). Producción: lo genera Stripe en el Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...


NEON_USER=user123...
NEON_URL_DB=jdbc:postgresql://...
NEON_PASSWORD=npg....

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# URL pública de la app. OPCIONAL: si se deja vacía, la app usa la URL de la
# propia petición (funciona aunque el dominio del deploy cambie). Sólo se fija
# para forzar un dominio concreto.
# STRIPE_BASE_URL=https://mi-dominio.com

# Puerto del servidor (opcional)
# SERVER_PORT=8080

# Sin STRIPE_API_KEY la app arranca normal y el cobro responde 503.
